# ───────────────────────────────────────────────────────────────────────────
# MVIT-Website – Environment-Vorlage
# Kopiere diese Datei nach .env (Produktion) bzw. .env.development.local (Dev)
# und trage alle Werte ein. Niemals echte Secrets committen!
#
#   cp .env.example .env
#   $EDITOR .env
# ───────────────────────────────────────────────────────────────────────────

# ── PostgreSQL / Superuser ───────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=BITTE_EIN_SEHR_LANGES_PASSWORT_EINTRAGEN
POSTGRES_DB=mvit

# ── Domain & Let's Encrypt ───────────────────────────────────────────────────
APP_DOMAIN=mphion.de
SSL_EMAIL=marvphoto@web.de

# ── API-Verbindungsstrings ───────────────────────────────────────────────────
# Host `db` entspricht dem Service-Namen in compose-prod.yaml.
# User/Passwort müssen mit den Rollen aus init-scripts/init.sql übereinstimmen.
DATABASE_URL=postgres://mvit-dev-rw:BITTE_PASSWORT_EINTRAGEN@db:5432/mvit
DRUPAL_DB_URL=postgres://drupal_user:BITTE_PASSWORT_EINTRAGEN@db:5432/drupal

# ── Drupal (optional, nur falls CMS genutzt) ─────────────────────────────────
# Erneste settings.php liest diese Variablen (DRUPAL_DB_*) über die Container-
# Umgebung. Init.sql erzeugt User `drupal_user`, Passwort entspricht dem in init
# gesetzten Hash. Anschließend an deine produktiven Credentials anpassen.
DRUPAL_DB_NAME=drupal
DRUPAL_DB_USER=drupal_user
DRUPAL_DB_PASSWORD=BITTE_DRUPAL_PASSWORT_EINTRAGEN
DRUPAL_DB_HOST=db
DRUPAL_DB_PORT=5432

# ── Image-Tag für CI/CD deployte Images ──────────────────────────────────────
# Default `latest` – pro Release wird ein SHA-Tag gesetzt.
TAG=latest

# ── Admin-Authentifizierung ────────────────────────────────────────────────────
# JWT Secret für Admin-Login (mindestens 32 Zeichen, zufällig generiert)
JWT_SECRET=BITTE_ZUFAELLIGEN_STRING_MIN_32_ZEICHEN

# Pepper für IP-Hashing (zufällig, mindestens 16 Zeichen)
PEPPER=BITTE_ZUFAELLIGEN_STRING_ERZEUGEN

# Erster Admin-User: Der Admin wird automatisch beim ersten Start erstellt.
# Ein zufälliges Passwort wird generiert und in den Container-Logs ausgegeben.
# ADMIN_DEFAULT_USERNAME: Name des Admin-Users (Standard: admin)
ADMIN_DEFAULT_USERNAME=admin

# ── Visitor-Counter ───────────────────────────────────────────────────────────
# Aufbewahrungsdauer der Besucherdaten in Tagen (Standard: 90)
VISIT_RETENTION_DAYS=90

# ── Frontend (öffentliche Browser-URLs) ────────────────────────────────────────
# Werden von Bun zur Serve-Zeit in `process.env.BUN_PUBLIC_*` inlinet.
# Defaults in compose-prod.yaml zeigen auf Prod; nur für Staging/Abweichung setzen.
# BUN_PUBLIC_API_BASE_URL=https://mphion.de/api
# BUN_PUBLIC_DRUPAL_BASE_URL=https://mphion.de/drupal